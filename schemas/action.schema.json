{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent action",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action"
  ],
  "oneOf": [
    {
      "properties": {
        "action": {
          "const": "list_records"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "table"
          ],
          "properties": {
            "table": {
              "enum": [
                "ledger",
                "invoices",
                "payments",
                "fx"
              ]
            },
            "cursor": {
              "type": [
                "string",
                "null"
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        }
      }
    },
    {
      "properties": {
        "action": {
          "const": "get_record"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "table",
            "id"
          ],
          "properties": {
            "table": {
              "enum": [
                "ledger",
                "invoices",
                "payments",
                "fx"
              ]
            },
            "id": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "properties": {
        "action": {
          "const": "get_document"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "doc_id"
          ],
          "properties": {
            "doc_id": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "properties": {
        "action": {
          "const": "calculator"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expression"
          ],
          "properties": {
            "expression": {
              "type": "string",
              "maxLength": 512
            }
          }
        }
      }
    },
    {
      "properties": {
        "action": {
          "const": "submit"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "findings"
          ],
          "properties": {
            "findings": {
              "$ref": "findings.schema.json"
            }
          }
        }
      }
    }
  ],
  "properties": {
    "action": {
      "enum": [
        "list_records",
        "get_record",
        "get_document",
        "calculator",
        "submit"
      ]
    },
    "args": {
      "type": "object"
    }
  }
}
