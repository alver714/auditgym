{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "findings object passed to submit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode_id",
    "findings"
  ],
  "properties": {
    "episode_id": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "affected_ids",
          "claimed_amount_minor",
          "currency",
          "evidence_ids",
          "explanation"
        ],
        "properties": {
          "type": {
            "enum": [
              "duplicate_invoice",
              "payment_misallocation",
              "fx_error",
              "period_cutoff"
            ]
          },
          "affected_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string"
            }
          },
          "claimed_amount_minor": {
            "type": "integer",
            "minimum": 0,
            "description": "base-currency minor units"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "evidence_ids": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string"
            }
          },
          "explanation": {
            "type": "string",
            "maxLength": 1000,
            "description": "never affects the score"
          }
        }
      }
    }
  }
}
