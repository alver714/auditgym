{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "generator config (configs/*.json)",
  "description": "Strict: unknown keys are rejected, config_id and config_version are required (X.Y.Z), probabilities lie in [0,1]. Mirrors auditgym.generator.config.validate_config, which is authoritative (it also checks cross-field rules such as the differing customer offset).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_id",
    "config_version"
  ],
  "properties": {
    "config_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "config_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "n_customers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 4,
            "maximum": 60
          }
        },
        "n_invoices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 14,
            "maximum": 105
          }
        },
        "n_noise_postings": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "foreign_invoice_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "base_currencies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "AED",
              "CHF",
              "EUR",
              "GBP",
              "JPY",
              "KZT",
              "USD"
            ]
          }
        },
        "foreign_currencies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "AED",
              "CHF",
              "EUR",
              "GBP",
              "JPY",
              "KZT",
              "USD"
            ]
          }
        },
        "timezones": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2
          }
        },
        "customer_offsets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[+-]\\d{2}:\\d{2}$"
          }
        },
        "years": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1990,
            "maximum": 2100
          }
        },
        "vat_rates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      }
    },
    "issues": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duplicate_invoice": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 12
          }
        },
        "payment_misallocation": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 12
          }
        },
        "fx_error": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 12
          }
        },
        "period_cutoff": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 12
          }
        }
      }
    },
    "interactions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fx_partial_payment_at_boundary": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        },
        "cutoff_with_wrong_rate_date": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        }
      }
    },
    "distractors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "split_payment": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          }
        },
        "overpayment_refund": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          }
        },
        "legit_recurring_amount": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          }
        },
        "timezone_boundary_ok": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          }
        },
        "realized_fx_gain_loss": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          }
        },
        "unreferenced_prepayment": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          }
        }
      }
    },
    "clean_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "force": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clean": {
          "type": "boolean"
        },
        "issues": {
          "type": "object"
        },
        "interactions": {
          "type": "object"
        },
        "distractors": {
          "type": "object"
        },
        "company": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base_currency": {
              "type": "string",
              "enum": [
                "AED",
                "CHF",
                "EUR",
                "GBP",
                "JPY",
                "KZT",
                "USD"
              ]
            },
            "timezone": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2
            },
            "year": {
              "type": "integer",
              "minimum": 1990,
              "maximum": 2100
            },
            "month": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "n_customers": {
              "type": "integer"
            },
            "n_invoices": {
              "type": "integer"
            },
            "n_noise_postings": {
              "type": "integer"
            },
            "foreign_currencies": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "AED",
                  "CHF",
                  "EUR",
                  "GBP",
                  "JPY",
                  "KZT",
                  "USD"
                ]
              }
            },
            "customer_offsets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[+-]\\d{2}:\\d{2}$"
              }
            },
            "foreign_invoice_share": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    }
  }
}
